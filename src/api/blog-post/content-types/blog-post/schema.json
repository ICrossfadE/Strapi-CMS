{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string"
    },
    "Slug": {
      "type": "string"
    },
    "Short_description": {
      "type": "text"
    },
    "Post_date": {
      "type": "date"
    },
    "Post_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "Post_text": {
      "type": "blocks"
    },
    "blog_category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::blog-category.blog-category",
      "mappedBy": "blog_post"
    },
    "Sort_order": {
      "type": "integer"
    }
  }
}
